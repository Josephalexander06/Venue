NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://venue:venue@localhost:5433/venue_dev
TEST_DATABASE_URL=postgres://venue:venue@localhost:5433/venue_test
# Browser tests write accounts and bookings here; keep it separate from dev data.
E2E_DATABASE_URL=postgres://venue:venue@localhost:5433/venue_e2e
FRONTEND_URL=http://localhost:5173
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
SESSION_RETENTION_DAYS=7
SESSION_CLEANUP_INTERVAL_HOURS=24
LOG_LEVEL=info
# log writes delivery records to the API log; webhook POSTs to an external relay.
NOTIFICATION_MODE=log
# NOTIFICATION_WEBHOOK_URL=https://notifications.example.edu/venue
# NOTIFICATION_WEBHOOK_TOKEN=replace-me
# Used only by `pnpm db:seed`. Change before any shared deployment.
SEED_ADMIN_EMAIL=admin@college.edu
SEED_ADMIN_PASSWORD=ChangeMeNow!2026
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
