{
  "name": "venue-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @venue/shared build && pnpm --parallel --filter @venue/api --filter @venue/web dev",
    "build": "pnpm --filter @venue/shared build && pnpm --filter @venue/api build && pnpm --filter @venue/web build",
    "typecheck": "pnpm --filter @venue/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @venue/api test",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @venue/api db:generate",
    "db:migrate": "pnpm --filter @venue/api db:migrate",
    "db:seed": "pnpm --filter @venue/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
