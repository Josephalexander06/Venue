# Copy to .env.production and replace every placeholder. Never commit the real file.
DOMAIN=venue.your-college.edu
POSTGRES_DB=venue
POSTGRES_USER=venue
# Use a long random value. URL-encode reserved characters when building DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password

SESSION_TTL_HOURS=24
SESSION_RETENTION_DAYS=7
SESSION_CLEANUP_INTERVAL_HOURS=24
RATE_LIMIT_MAX=300
LOG_LEVEL=info

# log is useful for a single server; webhook delivers to an email/SMS relay.
NOTIFICATION_MODE=webhook
NOTIFICATION_WEBHOOK_URL=https://notifications.your-college.edu/venue
NOTIFICATION_WEBHOOK_TOKEN=replace-with-a-random-bearer-token
NOTIFICATION_POLL_MS=15000
NOTIFICATION_MAX_ATTEMPTS=5

# Required only for the one-time seed command.
SEED_ADMIN_EMAIL=admin@your-college.edu
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
